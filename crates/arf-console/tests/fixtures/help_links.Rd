\name{crosslinks}
\title{Cross-reference targets}
\description{
Read \link{mean}, \link[stats]{lm}, and \link[=mean]{an average with a longer label}.
Aliases include \link{[}, \link{[[}, \link{\%/\%}, \link{\%in\%}, and \link{/}.
Qualified aliases include \link[base]{\%/\%} and \link[base:mean]{a different label}.
An ordinary \href{https://example.com/docs}{website} remains an HTTP link.
}
